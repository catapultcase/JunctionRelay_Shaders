{
  "name": "@junctionrelay/shader-clouds",
  "version": "1.0.0",
  "description": "Procedural cloudscape — layered FBM clouds with volumetric self-shadowing, god rays, and golden-hour lighting over a background texture",
  "junctionrelay": {
    "type": "shader",
    "shaderName": "junctionrelay.clouds",
    "emoji": "\u2601\ufe0f",
    "displayName": "Clouds",
    "description": "Procedural cloudscape overlay with layered FBM noise, volumetric self-shadowing, and god rays. Three cloud layers drift at different speeds with domain-warped turbulence. Sun position controls dramatic golden-hour lighting with bright edges and deep interior shadows. Layout content shows through cloud gaps. Star-pattern bloom adds warm glow to sunlit edges. Ambient light pass provides scene-wide exposure, directional gradients, and atmospheric haze.",
    "usesTexture": true,
    "feedback": true,
    "opaque": true,
    "passes": [
      {
        "entry": "clouds.glsl",
        "displayName": "Clouds"
      },
      {
        "entry": "bloom.glsl",
        "displayName": "Bloom"
      },
      {
        "entry": "ambient.glsl",
        "displayName": "Ambient Light"
      }
    ],
    "uniforms": [
      {
        "name": "cloudCoverage",
        "displayName": "Cloud Coverage",
        "type": "float",
        "pass": 0,
        "default": 0.55,
        "min": 0.0,
        "max": 1.0,
        "description": "How much of the sky is covered by clouds — 0 is scattered, 1 is fully overcast"
      },
      {
        "name": "cloudSpeed",
        "displayName": "Cloud Speed",
        "type": "float",
        "pass": 0,
        "default": 0.3,
        "min": 0.0,
        "max": 1.0,
        "description": "Wind speed — how fast clouds drift across the screen"
      },
      {
        "name": "windAngle",
        "displayName": "Wind Angle",
        "type": "float",
        "pass": 0,
        "default": 0.15,
        "min": 0.0,
        "max": 1.0,
        "description": "Wind direction — 0=right, 0.25=up, 0.5=left, 0.75=down"
      },
      {
        "name": "cloudScale",
        "displayName": "Cloud Scale",
        "type": "float",
        "pass": 0,
        "default": 0.5,
        "min": 0.1,
        "max": 2.0,
        "description": "Scale of cloud formations — lower values produce larger clouds, higher values produce smaller, more detailed clouds"
      },
      {
        "name": "cloudHeight",
        "displayName": "Cloud Height",
        "type": "float",
        "pass": 0,
        "default": 0.5,
        "min": 0.0,
        "max": 1.0,
        "description": "Vertical position of the main cloud layer on screen — 0 is bottom, 1 is top"
      },
      {
        "name": "sunAngle",
        "displayName": "Sun Angle",
        "type": "float",
        "pass": 0,
        "default": 0.15,
        "min": 0.0,
        "max": 1.0,
        "description": "Sun position — 0=right, 0.25=top, 0.5=left, 0.75=bottom"
      },
      {
        "name": "sunColor",
        "displayName": "Sun Color",
        "type": "color",
        "pass": 0,
        "default": [1.0, 0.85, 0.6],
        "description": "Color of sunlight — warm golden default for golden-hour look"
      },
      {
        "name": "shadowColor",
        "displayName": "Shadow Color",
        "type": "color",
        "pass": 0,
        "default": [0.15, 0.15, 0.3],
        "description": "Color of cloud shadows — cool blue default for natural volumetric shadow"
      },
      {
        "name": "godRayIntensity",
        "displayName": "God Ray Intensity",
        "type": "float",
        "pass": 0,
        "default": 0.3,
        "min": 0.0,
        "max": 1.0,
        "description": "Strength of light rays streaming through gaps in the clouds"
      },
      {
        "name": "cloudDensity",
        "displayName": "Cloud Density",
        "type": "float",
        "pass": 0,
        "default": 0.6,
        "min": 0.0,
        "max": 1.0,
        "description": "How opaque and thick the clouds are — affects shadow depth and background visibility"
      },
      {
        "name": "turbulence",
        "displayName": "Turbulence",
        "type": "float",
        "pass": 0,
        "default": 0.4,
        "min": 0.0,
        "max": 1.0,
        "description": "How chaotic and churning the cloud edges appear — higher values add more organic detail"
      },
      {
        "name": "bloomThreshold",
        "displayName": "Threshold",
        "type": "float",
        "pass": 1,
        "default": 0.72,
        "min": 0.0,
        "max": 1.0,
        "description": "Luminance cutoff — how bright a pixel must be to glow. Lower values bloom more of the image."
      },
      {
        "name": "bloomIntensity",
        "displayName": "Intensity",
        "type": "float",
        "pass": 1,
        "default": 0.6,
        "min": 0.0,
        "max": 2.0,
        "description": "Strength of the additive bloom composite — 0 disables bloom entirely, higher values create stronger glow"
      },
      {
        "name": "bloomSpread",
        "displayName": "Spread",
        "type": "float",
        "pass": 1,
        "default": 2.5,
        "min": 0.5,
        "max": 6.0,
        "description": "How far bloom rays extend from bright spots — higher values create wider, softer glow"
      },
      {
        "name": "bloomWarmth",
        "displayName": "Warmth",
        "type": "float",
        "pass": 1,
        "default": 0.5,
        "min": 0.0,
        "max": 1.0,
        "description": "Warm tint on bloom — 0 is neutral white, 1 is warm golden"
      },
      {
        "name": "lightColor",
        "displayName": "Light Color",
        "type": "color",
        "pass": 2,
        "default": [1.0, 1.0, 1.0],
        "description": "Scene light color — white is neutral, red for horror, amber for warm"
      },
      {
        "name": "lightIntensity",
        "displayName": "Light Intensity",
        "type": "float",
        "pass": 2,
        "default": 0.0,
        "min": 0.0,
        "max": 1.0,
        "description": "How strongly the light tints the scene — 0 means no effect"
      },
      {
        "name": "lightAngle",
        "displayName": "Light Angle",
        "type": "float",
        "pass": 2,
        "default": 0.0,
        "min": 0.0,
        "max": 1.0,
        "description": "Light direction — maps to 0-360 degrees. 0=right, 0.25=top, 0.5=left, 0.75=bottom"
      },
      {
        "name": "lightFocus",
        "displayName": "Light Focus",
        "type": "float",
        "pass": 2,
        "default": 0.0,
        "min": 0.0,
        "max": 1.0,
        "description": "0=uniform ambient everywhere, 1=strong directional gradient (lit side vs shadow side)"
      },
      {
        "name": "atmosphereColor",
        "displayName": "Atmosphere Color",
        "type": "color",
        "pass": 2,
        "default": [1.0, 1.0, 1.0],
        "description": "Haze/fog particle color — adds colored atmosphere to the scene"
      },
      {
        "name": "atmosphereDensity",
        "displayName": "Atmosphere Density",
        "type": "float",
        "pass": 2,
        "default": 0.0,
        "min": 0.0,
        "max": 1.0,
        "description": "How thick the atmospheric haze is — 0 is clear, 1 is dense fog"
      },
      {
        "name": "exposure",
        "displayName": "Exposure",
        "type": "float",
        "pass": 2,
        "default": 0.0,
        "min": -1.0,
        "max": 1.0,
        "description": "Overall brightness — negative darkens, positive brightens (EV-style: 2^exposure)"
      }
    ],
    "presets": [
