{
  "name": "@junctionrelay/shader-clouds",
  "version": "1.1.0",
  "description": "Procedural volumetric cloudscape — ray-marched FBM noise with silver lining, lightning, god rays, and bloom",
  "junctionrelay": {
    "type": "shader",
    "shaderName": "junctionrelay.clouds",
    "emoji": "\u2601\ufe0f",
    "displayName": "Clouds",
    "description": "Volumetric cloudscape via ray marching through a 3D FBM noise field. Camera flies over a cloud plane with flat bottoms and billowing tops. Silver lining on backlit edges, lightning flashes within clouds, screen-space god rays, and star-pattern bloom.",
    "usesTexture": false,
    "feedback": false,
    "opaque": true,
    "passes": [
      {
        "entry": "clouds.glsl",
        "displayName": "Clouds"
      },
      {
        "entry": "godrays.glsl",
        "displayName": "God Rays"
      },
      {
        "entry": "bloom.glsl",
        "displayName": "Bloom"
      }
    ],
    "uniforms": [
      {
        "name": "sunAngle",
        "displayName": "Sun Angle",
        "type": "float",
        "pass": 0,
        "default": 0.15,
        "min": 0.0,
        "max": 1.0,
        "description": "Sun position — 0=right, 0.25=top, 0.5=left, 0.75=bottom"
      },
      {
        "name": "sunColor",
        "displayName": "Sun Color",
        "type": "color",
        "pass": 0,
        "default": [1.0, 0.85, 0.6],
        "description": "Color of sunlight — warm golden default for golden-hour look"
      },
      {
        "name": "shadowColor",
        "displayName": "Shadow Color",
        "type": "color",
        "pass": 0,
        "default": [0.15, 0.15, 0.3],
        "description": "Color of cloud shadows — cool blue default for natural volumetric shadow"
      },
      {
        "name": "skyColor",
        "displayName": "Sky Color",
        "type": "color",
        "pass": 0,
        "default": [0.52, 0.63, 0.75],
        "description": "Base sky gradient color — visible between and behind clouds"
      },
      {
        "name": "cloudCoverage",
        "displayName": "Cloud Coverage",
        "type": "float",
        "pass": 0,
        "default": 0.55,
        "min": 0.0,
        "max": 1.0,
        "description": "How much sky is covered — 0 is scattered, 1 is fully overcast"
      },
      {
        "name": "cloudSpeed",
        "displayName": "Cloud Speed",
        "type": "float",
        "pass": 0,
        "default": 0.3,
        "min": 0.0,
        "max": 1.0,
        "description": "Wind speed — how fast clouds drift and the camera flies"
      },
      {
        "name": "cloudSparseness",
        "displayName": "Cloud Sparseness",
        "type": "float",
        "pass": 0,
        "default": 1.0,
        "min": 0.3,
        "max": 3.0,
        "description": "Distance between cloud clumps — low is tightly packed, high is wide open sky between clumps"
      },
      {
        "name": "silverLining",
        "displayName": "Silver Lining",
        "type": "float",
        "pass": 0,
        "default": 0.5,
        "min": 0.0,
        "max": 1.0,
        "description": "Bright rim on backlit cloud edges — 0 is off, 1 is intense silver lining"
      },
      {
        "name": "lightningIntensity",
        "displayName": "Lightning",
        "type": "float",
        "pass": 0,
        "default": 0.0,
        "min": 0.0,
        "max": 1.0,
        "description": "Random lightning flashes inside clouds — 0 is off, higher is brighter flashes"
      },
      {
        "name": "sunAngle",
        "displayName": "Sun Angle",
        "type": "float",
        "pass": 1,
        "default": 0.15,
        "min": 0.0,
        "max": 1.0,
        "description": "Sun position for god ray origin (synced with pass 0)"
      },
      {
        "name": "godrayIntensity",
        "displayName": "Intensity",
        "type": "float",
        "pass": 1,
        "default": 0.4,
        "min": 0.0,
        "max": 2.0,
        "description": "Strength of the light shafts"
      },
      {
        "name": "godrayDecay",
        "displayName": "Decay",
        "type": "float",
        "pass": 1,
        "default": 0.96,
        "min": 0.9,
        "max": 1.0,
        "description": "How quickly rays fade along their length — higher is longer rays"
      },
      {
        "name": "godrayDensity",
        "displayName": "Density",
        "type": "float",
        "pass": 1,
        "default": 0.8,
        "min": 0.1,
        "max": 2.0,
        "description": "Sample spacing — higher stretches rays further from the sun"
      },
      {
        "name": "bloomThreshold",
        "displayName": "Threshold",
        "type": "float",
        "pass": 2,
        "default": 0.72,
        "min": 0.0,
        "max": 1.0,
        "description": "Luminance cutoff — how bright a pixel must be to glow"
      },
      {
        "name": "bloomIntensity",
        "displayName": "Intensity",
        "type": "float",
        "pass": 2,
        "default": 0.6,
        "min": 0.0,
        "max": 2.0,
        "description": "Strength of the bloom glow"
      },
      {
        "name": "bloomSpread",
        "displayName": "Spread",
        "type": "float",
        "pass": 2,
        "default": 2.5,
        "min": 0.5,
        "max": 6.0,
        "description": "How far bloom rays extend from bright spots"
      },
      {
        "name": "bloomWarmth",
        "displayName": "Warmth",
        "type": "float",
        "pass": 2,
        "default": 0.5,
        "min": 0.0,
        "max": 1.0,
        "description": "Warm tint on bloom — 0 is neutral, 1 is warm golden"
      }
    ],
