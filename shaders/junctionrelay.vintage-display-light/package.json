{
  "name": "@junctionrelay/shader-vintage-display-light",
  "version": "1.0.0",
  "description": "Pi-optimized retro CRT: phosphor tint, scanlines, signal noise, vignette, all in a single pass",
  "junctionrelay": {
    "type": "shader",
    "shaderName": "junctionrelay.vintage-display-light",
    "emoji": "📺",
    "displayName": "Vintage Display - Light",
    "description": "Single-pass CRT shader optimized for low-power hardware (Raspberry Pi, ARM). Barrel distortion, monochrome phosphor color grading, scanlines, pixel grid, static snow, raster ripple, sync roll, power flicker, vignette, grain, warmth, and gamma. 1 texture lookup per fragment, no bloom, no ghosting, no glitch strips. 12 uniforms, 8 presets.",
    "usesTexture": true,
    "feedback": false,
    "opaque": true,
    "passes": [
      {
        "entry": "vintage-display-light.glsl",
        "displayName": "Display"
      }
    ],
    "uniforms": [
      {
        "name": "phosphorColor",
        "displayName": "Phosphor Color",
        "type": "color",
        "pass": 0,
        "default": [0.2, 1.0, 0.3],
        "description": "Monochrome phosphor tint: green P1, amber, white, blue"
      },
      {
        "name": "phosphorDrive",
        "displayName": "Phosphor Drive",
        "type": "float",
        "pass": 0,
        "default": 0.85,
        "min": 0.3,
        "max": 1.5,
        "description": "Luminance response curve: lower darkens mids, higher overdrives bright areas"
      },
      {
        "name": "scanlineWeight",
        "displayName": "Scanline Weight",
        "type": "float",
        "pass": 0,
        "default": 0.5,
        "min": 0.0,
        "max": 1.0,
        "description": "Scanline darkness: 0 disables, 1 is full black alternating lines"
      },
      {
        "name": "warpAmount",
        "displayName": "Screen Warp",
        "type": "float",
        "pass": 0,
        "default": 0.04,
        "min": 0.0,
        "max": 0.12,
        "description": "CRT barrel distortion strength"
      },
      {
        "name": "pixelGrid",
        "displayName": "Pixel Grid",
        "type": "float",
        "pass": 0,
        "default": 0.25,
        "min": 0.0,
        "max": 1.0,
        "description": "Shadow mask / dot grid visibility"
      },
      {
        "name": "brightness",
        "displayName": "Brightness",
        "type": "float",
        "pass": 0,
        "default": 0.0,
        "min": -0.5,
        "max": 0.5,
        "description": "Screen brightness offset"
      },
      {
        "name": "staticAmount",
        "displayName": "Static",
        "type": "float",
        "pass": 0,
        "default": 0.04,
        "min": 0.0,
        "max": 1.0,
        "description": "Snow / noise overlay: simulates RF interference or weak signal"
      },
      {
        "name": "rippleStrength",
        "displayName": "Raster Ripple",
        "type": "float",
        "pass": 0,
        "default": 0.03,
        "min": 0.0,
        "max": 0.15,
        "description": "Horizontal interference bands"
      },
      {
        "name": "rollSpeed",
        "displayName": "Sync Roll",
        "type": "float",
        "pass": 0,
        "default": 0.07,
        "min": 0.0,
        "max": 0.5,
        "description": "Vertical hold drift rate"
      },
      {
        "name": "vignetteAmount",
        "displayName": "Vignette",
        "type": "float",
        "pass": 0,
        "default": 0.6,
        "min": 0.0,
        "max": 1.0,
        "description": "Bezel edge darkening"
      },
      {
        "name": "flickerAmount",
        "displayName": "Flicker",
        "type": "float",
        "pass": 0,
        "default": 0.02,
        "min": 0.0,
        "max": 0.15,
        "description": "Power supply instability: slow brightness oscillation"
      },
      {
        "name": "grainAmount",
        "displayName": "Film Grain",
        "type": "float",
        "pass": 0,
        "default": 0.03,
        "min": 0.0,
        "max": 0.15,
        "description": "Phosphor / film noise overlay"
      },
      {
        "name": "warmth",
        "displayName": "Warmth",
        "type": "float",
        "pass": 0,
        "default": 0.15,
        "min": 0.0,
        "max": 1.0,
        "description": "Age yellowing / warm shift"
      }
    ],
    "presets": [
      {
        "name": "Data Stream",
        "default": true,
