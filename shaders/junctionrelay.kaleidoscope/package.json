{
  "name": "@junctionrelay/shader-kaleidoscope",
  "version": "2.0.0",
  "description": "Animated kaleidoscope with layered fractal noise, feedback trails, and bloom. Two-colour tint, configurable symmetry, and temporal glow.",
  "junctionrelay": {
    "type": "shader",
    "shaderName": "junctionrelay.kaleidoscope",
    "emoji": "\ud83d\udd2e",
    "displayName": "Kaleidoscope",
    "description": "Two-pass animated kaleidoscope with fractal noise folded into radial segments. Pass 0 generates the pattern with feedback trails stored in alpha. Pass 1 applies a bloom glow. Dual colour tints, adjustable symmetry, zoom, speeds, brightness, and vignette.",
    "usesTexture": false,
    "feedback": true,
    "opaque": true,
    "passes": [
      {
        "entry": "kaleidoscope.glsl",
        "displayName": "Pattern + Trails"
      },
      {
        "entry": "bloom.glsl",
        "displayName": "Bloom"
      }
    ],
    "uniforms": [
      {
        "name": "colorTintA",
        "displayName": "Colour A",
        "type": "color",
        "pass": 0,
        "default": [
          0.4,
          0.6,
          1.0
        ],
        "description": "Primary colour tint for the palette"
      },
      {
        "name": "colorTintB",
        "displayName": "Colour B",
        "type": "color",
        "pass": 0,
        "default": [
          1.0,
          0.3,
          0.6
        ],
        "description": "Secondary colour tint blended with Colour A"
      },
      {
        "name": "segments",
        "displayName": "Segments",
        "type": "float",
        "pass": 0,
        "default": 8.0,
        "min": 3.0,
        "max": 24.0,
        "description": "Number of radial symmetry segments \u2014 more segments create tighter, more intricate patterns"
      },
      {
        "name": "zoom",
        "displayName": "Zoom",
        "type": "float",
        "pass": 0,
        "default": 2.0,
        "min": 0.5,
        "max": 8.0,
        "description": "Pattern zoom level \u2014 higher values reveal finer detail"
      },
      {
        "name": "rotationSpeed",
        "displayName": "Rotation Speed",
        "type": "float",
        "pass": 0,
        "default": 0.15,
        "min": 0.0,
        "max": 1.0,
        "description": "How fast the kaleidoscope rotates"
      },
      {
        "name": "flowSpeed",
        "displayName": "Flow Speed",
        "type": "float",
        "pass": 0,
        "default": 0.3,
        "min": 0.0,
        "max": 2.0,
        "description": "Speed of the underlying pattern animation \u2014 0 freezes the pattern"
      },
      {
        "name": "colorCycleSpeed",
        "displayName": "Colour Cycle",
        "type": "float",
        "pass": 0,
        "default": 0.5,
        "min": 0.0,
        "max": 3.0,
        "description": "Speed of colour palette cycling \u2014 0 for static colours"
      },
      {
        "name": "brightness",
        "displayName": "Brightness",
        "type": "float",
        "pass": 0,
        "default": 1.0,
        "min": 0.3,
        "max": 2.0,
        "description": "Overall brightness multiplier"
      },
      {
        "name": "vignetteAmount",
        "displayName": "Vignette",
        "type": "float",
        "pass": 0,
        "default": 0.4,
        "min": 0.0,
        "max": 1.0,
        "description": "Edge darkening \u2014 frames the pattern with a soft border"
      },
      {
        "name": "trailDecay",
        "displayName": "Trail Decay",
        "type": "float",
        "pass": 0,
        "default": 0.92,
        "min": 0.0,
        "max": 0.99,
        "description": "How long feedback trails persist \u2014 higher = longer trails, 0 = no trails"
      },
      {
        "name": "bloomAmount",
        "displayName": "Bloom",
        "type": "float",
        "pass": 1,
        "default": 0.4,
        "min": 0.0,
        "max": 2.0,
        "description": "Intensity of the bloom glow effect"
      }
    ],
    "presets": [
      {
