{
  "name": "@junctionrelay/shader-plasma",
  "version": "1.0.0",
  "description": "Generative FBM plasma — swirling color fields driven by fractional Brownian motion, no texture input",
  "junctionrelay": {
    "type": "shader",
    "shaderName": "junctionrelay.plasma",
    "emoji": "🌀",
    "displayName": "Plasma",
    "description": "GPU-only generative plasma effect. Layered fractional Brownian motion creates swirling, organic color fields. Fully procedural — no texture input required. Custom uniforms control animation speed and two-tone color palette via sensor bindings.",
    "feedback": false,
    "opaque": true,
    "passes": [
      {
        "entry": "plasma.glsl",
        "displayName": "Plasma"
      }
    ],
    "usesTexture": false,
    "uniforms": [
      {
        "name": "uSpeed",
        "displayName": "Speed",
        "type": "float",
        "pass": 0,
        "default": 1.0,
        "min": 0.1,
        "max": 3.0,
        "description": "Animation speed multiplier"
      },
      {
        "name": "uPrimaryColor",
        "displayName": "Primary Color",
        "type": "color",
        "pass": 0,
        "default": [0.4, 0.067, 0.8],
        "description": "Dominant plasma color"
      },
      {
        "name": "uSecondaryColor",
        "displayName": "Secondary Color",
        "type": "color",
        "pass": 0,
        "default": [1.0, 0.4, 0.0],
        "description": "Accent plasma color"
      }
    ]
  }
}
