{
  "name": "@junctionrelay/shader-rain-window",
  "version": "4.1.0",
  "description": "Rain on glass \u2014 realistic drops with refraction, trails, fog, temporal persistence, bloom, and ambient lighting over a background texture",
  "junctionrelay": {
    "type": "shader",
    "shaderName": "junctionrelay.rain-window",
    "emoji": "\ud83c\udf27\ufe0f",
    "displayName": "Rain Window",
    "description": "Rainy glass overlay with temporal persistence, bloom, and ambient lighting. Drops roll down the surface leaving trails that cut through condensation fog. Wet marks persist and slowly evaporate over ~3 seconds via feedback. Star-pattern bloom adds warm glow to specular highlights. Ambient light pass provides scene-wide colored lighting, directional gradients, and atmospheric haze.",
    "usesTexture": true,
    "feedback": true,
    "opaque": true,
    "passes": [
      {
        "entry": "rain.glsl",
        "displayName": "Rain"
      },
      {
        "entry": "bloom.glsl",
        "displayName": "Bloom"
      },
      {
        "entry": "ambient.glsl",
        "displayName": "Ambient Light"
      }
    ],
    "uniforms": [
      {
        "name": "rainAmount",
        "displayName": "Rain Amount",
        "type": "float",
        "pass": 0,
        "default": 0.3,
        "min": 0.0,
        "max": 1.0,
        "description": "Density of rain \u2014 controls settled droplets, large rolling drops, and small fast drops"
      },
      {
        "name": "fogAmount",
        "displayName": "Glass Fog",
        "type": "float",
        "pass": 0,
        "default": 0.1,
        "min": 0.0,
        "max": 1.0,
        "description": "How foggy the glass surface appears \u2014 higher values blur the background more"
      },
      {
        "name": "dropSize",
        "displayName": "Drop Size",
        "type": "float",
        "pass": 0,
        "default": 0.6,
        "min": 0.1,
        "max": 1.5,
        "description": "Scales the radius of all raindrops \u2014 lower for fine mist, higher for large heavy drops"
      },
      {
        "name": "pathVariance",
        "displayName": "Path Variance",
        "type": "float",
        "pass": 0,
        "default": 0.3,
        "min": 0.0,
        "max": 1.0,
        "description": "Controls how erratically drops meander as they fall \u2014 0 is straight down, higher values add lateral wobble and erratic jitter"
      },
      {
        "name": "windDir",
        "displayName": "Wind Direction",
        "type": "float",
        "pass": 0,
        "default": 0.7,
        "min": -1.0,
        "max": 1.0,
        "description": "Wind direction \u2014 negative blows left, positive blows right. Tilts background streaks and biases drop drift on glass."
      },
      {
        "name": "glassTilt",
        "displayName": "Glass Tilt",
        "type": "float",
        "pass": 0,
        "default": 0.8,
        "min": -1.0,
        "max": 1.0,
        "description": "Glass surface tilt \u2014 negative tilts left, positive tilts right. Drops drift toward the low side under gravity."
      },
      {
        "name": "surfaceTension",
        "displayName": "Glass Cling",
        "type": "float",
        "pass": 0,
        "default": 0.2,
        "min": 0.0,
        "max": 1.0,
        "description": "How clingy the glass surface is \u2014 low values let drops slide quickly, high values make them cling longer and fall slower"
      },
      {
        "name": "viscosity",
        "displayName": "Viscosity",
        "type": "float",
        "pass": 0,
        "default": 0.0,
        "min": 0.0,
        "max": 1.0,
        "description": "Liquid thickness \u2014 0 is water, higher values produce slower, rounder drops with wider trails (blood, honey, syrup)"
      },
      {
        "name": "liquidColor",
        "displayName": "Liquid Color",
        "type": "color",
        "pass": 0,
        "default": [
          1.0,
          1.0,
          1.0
        ],
        "description": "Tint color of the liquid \u2014 white for water, red for blood, amber for honey"
      },
      {
        "name": "liquidOpacity",
        "displayName": "Liquid Opacity",
        "type": "float",
        "pass": 0,
        "default": 0.0,
        "min": 0.0,
        "max": 1.0,
        "description": "How opaque the liquid is \u2014 0 is fully clear (refraction only), 1 is solid colored liquid"
      },
      {
        "name": "bloomThreshold",
        "displayName": "Threshold",
        "type": "float",
        "pass": 1,
        "default": 0.72,
        "min": 0.0,
        "max": 1.0,
        "description": "Luminance cutoff \u2014 how bright a pixel must be to glow. Lower values bloom more of the image."
      },
      {
        "name": "bloomIntensity",
        "displayName": "Intensity",
        "type": "float",
        "pass": 1,
        "default": 0.6,
        "min": 0.0,
        "max": 2.0,
        "description": "Strength of the additive bloom composite \u2014 0 disables bloom entirely, higher values create stronger glow"
      },
      {
        "name": "bloomSpread",
        "displayName": "Spread",
        "type": "float",
        "pass": 1,
        "default": 2.5,
        "min": 0.5,
        "max": 6.0,
        "description": "How far bloom rays extend from bright spots \u2014 higher values create wider, softer glow"
      },
      {
        "name": "bloomWarmth",
        "displayName": "Warmth",
        "type": "float",
        "pass": 1,
        "default": 0.5,
        "min": 0.0,
        "max": 1.0,
        "description": "Warm tint on bloom \u2014 0 is neutral white, 1 is warm golden (light through water absorbs blue)"
      },
      {
        "name": "lightColor",
        "displayName": "Light Color",
        "type": "color",
        "pass": 2,
        "default": [
          1.0,
          1.0,
          1.0
        ],
        "description": "Scene light color \u2014 white is neutral, red for horror, amber for warm"
      },
      {
        "name": "lightIntensity",
        "displayName": "Light Intensity",
        "type": "float",
        "pass": 2,
        "default": 0.0,
        "min": 0.0,
        "max": 1.0,
        "description": "How strongly the light tints the scene \u2014 0 means no effect"
      },
      {
        "name": "lightAngle",
        "displayName": "Light Angle",
        "type": "float",
        "pass": 2,
        "default": 0.0,
        "min": 0.0,
        "max": 1.0,
        "description": "Light direction \u2014 maps to 0-360 degrees. 0=right, 0.25=top, 0.5=left, 0.75=bottom"
      },
      {
        "name": "lightFocus",
        "displayName": "Light Focus",
        "type": "float",
        "pass": 2,
        "default": 0.0,
        "min": 0.0,
        "max": 1.0,
        "description": "0=uniform ambient everywhere, 1=strong directional gradient (lit side vs shadow side)"
      },
      {
        "name": "atmosphereColor",
        "displayName": "Atmosphere Color",
        "type": "color",
        "pass": 2,
        "default": [
          1.0,
          1.0,
          1.0
        ],
        "description": "Haze/fog particle color \u2014 adds colored atmosphere to the scene"
      },
      {
        "name": "atmosphereDensity",
        "displayName": "Atmosphere Density",
        "type": "float",
        "pass": 2,
        "default": 0.0,
        "min": 0.0,
        "max": 1.0,
        "description": "How thick the atmospheric haze is \u2014 0 is clear, 1 is dense fog"
      },
      {
        "name": "exposure",
        "displayName": "Exposure",
        "type": "float",
        "pass": 2,
        "default": 0.0,
        "min": -1.0,
        "max": 1.0,
        "description": "Overall brightness \u2014 negative darkens, positive brightens (EV-style: 2^exposure)"
      }
    ],
